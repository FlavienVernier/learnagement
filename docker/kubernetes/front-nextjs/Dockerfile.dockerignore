# Purpose: restrict the Next.js image build context and exclude local secrets/build artifacts.
**
!front_NextJS/
!front_NextJS/**

**/.env
**/.env.*
**/*.pem
**/*.key
**/*.crt
**/*.p12
front_NextJS/node_modules/
front_NextJS/.next/
front_NextJS/tests/
front_NextJS/tsconfig.tsbuildinfo
front_NextJS/app/health/route.ts
