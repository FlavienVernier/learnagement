###########################################################################
# Spécific environment variables values for development environment       #
# Do not edit "__env_default_XXX.env" for your instance, edit your .env   #
# or spécific .env_XXX.env                                                #
###########################################################################

ENV=prod

# Set ACME_STAGING true for 1st test
ACME_STAGING=true
# if TRAEFIK phpmyadmin is a subdomain and does not have exposed port
TRAEFIK_API_PORT=8080
# ToDo Check if its docker or exposed port
PHPMYADMIN_PORT=8080

BACKEND_PYTHON_PORT=4000

FRONT_PHP_DOCKER_PORT=443
FRONT_PHP_PORT=443
FRONT_PHP_PROTOCOL=https

FRONT_DASH_PORT=8050

FRONT_NEXTAUTH_PORT=3000

# App entry point set to front PHP
INSTANCE_PORT=433
INSTANCE_PROTOCOL=https
