#########################################################################
# Skeleton of .env, it contains allrequired environment variables       #
# Dev is default environment                                            #
# Do not edit it for your instance, edit your .env                      #
#########################################################################

#########################################################################
# Edit only .env in the Learnagement root directory,                    #
#########################################################################

ENV=dev
SESSION_TIMEOUT=900
DOCKER_COMMAND=docker
DOCKER_COMPOSE_COMMAND="docker compose"
SSL_DIR=../certs/

DEFAULT_TROMBI_PICTURE='/APP_2026/assets/Poly_Smiley_300x300.png'
PERS_TROMBI_DIR=PERS_TROMBI_DIR
ETU_TROMBI_DIR=ETU_TROMBI_DIR

LDAP_HOST=LDAP_HOST
LDAP_BASE_DN=LDAP_BASE_DN
LDAP_UID_ATTR=LDAP_UID_ATTR

CAS_PROXY_HOST=CAS_PROXY_HOST
CAS_HOST=CAS_HOST
CAS_PROXY_LOOK4=CAS_PROXY_LOOK4

#########################################################################
# DO NOT EDIT ANY VARIABLE AFTER THIS LINE
#########################################################################

############################## Instance #################################

DOCKER_SSL_DIR=/etc/ssl/learnagement/
COMPOSE_PROJECT_NAME=learnagement_INSTANCE_NAME
INSTANCE_NAME=INSTANCE_NAME
# Instance number cannot be 1
INSTANCE_NUMBER=INSTANCE_NUMBER
INSTANCE_SECRET=INSTANCE_SECRET
INSTANCE_URL=INSTANCE_URL

############################## MySQL ####################################

MYSQL_SERVER=learnagement_mysql_INSTANCE_NAME
MYSQL_PORT=3306
MYSQL_DB=learnagement
MYSQL_ROOT_PASSWORD=MYSQL_ROOT_PASSWORD
MYSQL_USER_LOGIN=learnagement
MYSQL_USER_PASSWORD=MYSQL_USER_PASSWORD

############################## Python Backend ############################

BACKEND_PYTHON_DOCKER_URL=http://learnagement_backend_python_INSTANCE_NAME
BACKEND_PYTHON_DOCKER_PORT=4000
BACKEND_PYTHON_PORT=4000

############################## Fronts ###################################
# Public front urls are : INSTANCE_URL
# on port composed by 5 digits, the 1st one is INSTANCE_NUMBER, lasts are docker front port
# Example: for instance number 4 if the FRONT_PH_PORT is 80, its public port is 40080

############################## PHP ######################################

FRONT_PHP_DOCKER_PORT=80
FRONT_PHP_PORT=80
FRONT_PHP_PROTOCOL=http

############################## Dash Plotly ##############################

FRONT_DASH_DOCKER_PORT=8050
FRONT_DASH_PORT=8050

############################## NextAuth #################################

FRONT_NEXTAUTH_DOCKER_PORT=3000
FRONT_NEXTAUTH_PORT=3000

#########################################################################
